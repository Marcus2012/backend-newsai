# Production Environment Configuration
# Copy this file to .env and fill in the actual values before deployment

# Application Settings
APP_NAME=News AI Generator API
APP_VERSION=1.0.0
DEBUG=False
SECRET_KEY=YOUR_SECURE_SECRET_KEY_HERE_CHANGE_THIS

# Algorithm for JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (Use PostgreSQL from Neon, Railway, or similar)
# Format: postgresql+asyncpg://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/news_ai?sslmode=require

# Google Gemini API
GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-pro

# Groq API
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile

# ScrapeGraph Configuration
SCRAPEGRAPH_ENDPOINT=http://localhost:8001/api/scrape

# FootyStats API
FOOTYSTATS_API_KEY=YOUR_FOOTYSTATS_API_KEY_HERE
FOOTYSTATS_BASE_URL=https://api.football-data-api.com
FOOTYSTATS_PRESET_LEAGUES={}

# WordPress Configuration
WP_GRAPHQL_ENDPOINT=https://your-wordpress-site.com/graphql
WP_AUTH_TOKEN=YOUR_WORDPRESS_AUTH_TOKEN_HERE

# Scraping Configuration
SCRAPE_URLS=https://rpp.pe/deportes,https://depor.com/,https://www.espn.com.pe/

# CORS Configuration
CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Additional Cloud Run Settings
PORT=8080
