# ==================================
# News AI Generator - Environment Variables
# ==================================
# Copy this file to .env and fill in your values

# Application
APP_NAME="News AI Generator API"
APP_VERSION="1.0.0"
DEBUG=false

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (MySQL - Google Cloud SQL)
# Format: mysql+aiomysql://user:password@host:port/database
DATABASE_URL=mysql+aiomysql://root:YOUR_PASSWORD@34.186.86.182:3306/newsai

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# FootyStats API
FOOTYSTATS_API_KEY=f37d0d7b03a98882d9a3672336c2a30d89ade024875637d35b5cd5f224149d0e
FOOTYSTATS_BASE_URL=https://www.footystats.org/api/
# Optional presets as JSON. Example below preconfigures Perú Primera y Segunda División (2025 season_id)
FOOTYSTATS_PRESET_LEAGUES={"peru_primera":{"name":"Peru Primera División","country":"Peru","league_name":"Primera División","season_id":14912,"season":2025},"peru_segunda":{"name":"Peru Segunda División","country":"Peru","league_name":"Segunda División","season_id":16183,"season":2025}}

# ScrapeGraphAI Service
SCRAPEGRAPH_ENDPOINT=http://localhost:8001/api/scrape

# WordPress GraphQL
WP_GRAPHQL_ENDPOINT=https://your-wordpress-site.com/graphql
WP_AUTH_TOKEN=your_wordpress_jwt_token

# URLs to scrape (comma-separated)
SCRAPE_URLS=https://www.bbc.com/news,https://www.elcomercio.pe,https://www.rpp.pe

# CORS Origins (comma-separated, use * for development)
CORS_ORIGINS=*
