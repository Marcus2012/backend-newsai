# ==================================
# News AI Generator - Environment Variables
# ==================================
# Copy this file to .env and fill in your values

# Application
APP_NAME="News AI Generator API"
APP_VERSION="1.0.0"
DEBUG=false

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (MySQL - Google Cloud SQL)
# Format: mysql+aiomysql://user:password@host:port/database
#DATABASE_URL=mysql+aiomysql://root:YOUR_PASSWORD@34.186.86.182:3306/newsai
DATABASE_URL="mysql+aiomysql://newsai:NewsaiNew2025!@127.0.0.1:3306/newsai"
# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Sportmonks API (nuevo proveedor de fútbol)
SPORTMONKS_API_TOKEN=P9KAhYqDTfBYlHawRg7SJss0Z3w4cTB8twHLFbYEiIEBHZUBK9cYR267THjb
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
SPORTMONKS_PREMIER_LEAGUE_ID=8
SPORTMONKS_PREMIER_SEASON_ID=23614
SPORTMONKS_SERIEA_LEAGUE_ID=384
SPORTMONKS_SERIEA_SEASON_ID=23598

# ScrapeGraphAI Service
SCRAPEGRAPH_ENDPOINT=http://localhost:8001/api/scrape

# WordPress GraphQL
WP_GRAPHQL_ENDPOINT=https://your-wordpress-site.com/graphql
WP_AUTH_TOKEN=your_wordpress_jwt_token

# URLs to scrape (comma-separated)
SCRAPE_URLS=https://www.bbc.com/news,https://www.elcomercio.pe,https://www.rpp.pe

# CORS Origins (comma-separated, use * for development)
CORS_ORIGINS=*


# Local .env for development (DO NOT commit to production)

